{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "npm run build && wrangler pages dev out",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "CLOUDFLARE_ACCOUNT_ID=5abd6d7c8175ba56c3058e34db158aa8 wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/configure-cloudflare.mjs && npm test && npm run typecheck && npm run build && npm run db:migrate:remote && CLOUDFLARE_ACCOUNT_ID=5abd6d7c8175ba56c3058e34db158aa8 wrangler pages deploy out --project-name acp-landing --branch main"
  },
  "dependencies": {
    "@amazecontinuityprojects/amazeui": "^1.1.0",
    "clsx": "^2.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  }
}
